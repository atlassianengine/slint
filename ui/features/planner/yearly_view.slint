import { Colors } from "@UIKitSlint";
import { PlannerCalendarCell, PlannerYearSummary } from "../../models.slint";

export component YearlyView inherits Rectangle {
    in property <[PlannerYearSummary]> year-summaries;
    in property <[PlannerCalendarCell]> year-cells;

    callback month-selected(int);

    background: Colors.paper-body;
    property <int> grid-columns: root.width < 980px ? 3 : 4;

    VerticalLayout {
        width: 100%;
        height: 100%;
        padding: 12px;

        GridLayout {
            width: 100%;
            height: 100%;
            spacing: 10px;

            for month-summary[idx] in root.year-summaries : Rectangle {
                row: idx / root.grid-columns;
                col: Math.mod(idx, root.grid-columns);
                min-height: 220px;
                background: Colors.paper-surface;
                border-color: Colors.border-subtle;
                border-width: 1px;
                border-radius: 10px;

                VerticalLayout {
                    width: 100%;
                    height: 100%;
                    padding: 10px;
                    spacing: 6px;

                    Rectangle {
                        width: 100%;
                        height: 22px;
                        background: Colors.primary.with-alpha(0.12);
                        border-radius: 6px;
                        TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => {
                                root.month-selected(month-summary.month-number);
                            }
                        }

                        Text {
                            width: 100%;
                            height: 100%;
                            text: month-summary.month-name;
                            color: Colors.ink-body;
                            font-size: 14px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    GridLayout {
                        width: 100%;
                        height: 100%;
                        spacing: 1px;

                        for local-day in 42 : Rectangle {
                            row: local-day / 7;
                            col: Math.mod(local-day, 7);
                            width: 100%;
                            height: 12px;

                            background: root.year-cells[idx * 42 + local-day].is-current-month
                                ? (root.year-cells[idx * 42 + local-day].density > 6
                                    ? Colors.primary.with-alpha(0.60)
                                    : root.year-cells[idx * 42 + local-day].density > 3
                                    ? Colors.primary.with-alpha(0.35)
                                    : root.year-cells[idx * 42 + local-day].density > 1
                                    ? Colors.primary.with-alpha(0.20)
                                    : root.year-cells[idx * 42 + local-day].density > 0
                                    ? Colors.primary.with-alpha(0.12)
                                    : Colors.paper-body)
                                : Colors.paper-body;
                            border-color: Colors.border-subtle;
                            border-width: 0.5px;

                            if root.year-cells[idx * 42 + local-day].is-today : Rectangle {
                                x: 3px;
                                y: 3px;
                                width: 6px;
                                height: 6px;
                                border-radius: 3px;
                                background: Colors.primary;
                            }

                            if root.year-cells[idx * 42 + local-day].is-current-month
                            && root.year-cells[idx * 42 + local-day].day-number > 0 : Text {
                                width: 100%;
                                text: root.year-cells[idx * 42 + local-day].day-number;
                                font-size: 6px;
                                color: Colors.ink-muted;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}