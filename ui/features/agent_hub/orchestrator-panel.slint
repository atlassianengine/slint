import { ScrollView } from "std-widgets.slint";
import { Borders, Colors, Motion, Spacing, Typography, Button, ButtonVariant, ScrollArea } from "@UIKitSlint";

export struct ExecutionEnvelopeItem {
    id: string,
    agent-name: string,
    task-description: string,
    status: string,
    started-at: string,
}

export component OrchestratorPanel inherits Rectangle {
    in property <[ExecutionEnvelopeItem]> envelopes;
    in property <string> active-log-output: "";

    callback cancel-execution-requested(string);

    background: Colors.paper-body;

    VerticalLayout {
        padding: Spacing.space-4;
        spacing: Spacing.space-3;

        Text {
            text: "AI Agent Orchestrator & Execution Stream";
            color: Colors.ink-headers;
            font-family: Typography.font-display;
            font-size: Typography.size-md;
            font-weight: Typography.weight-semibold;
        }

        // Active Envelopes
        ScrollView {
            height: 200px;
            VerticalLayout {
                spacing: Spacing.space-2;
                for env in root.envelopes: Rectangle {
                    height: 52px;
                    background: Colors.paper-surface;
                    border-radius: Borders.radius-md;
                    border-width: Borders.width;
                    border-color: Colors.border-subtle;

                    HorizontalLayout {
                        padding-left: Spacing.space-4;
                        padding-right: Spacing.space-4;
                        spacing: Spacing.space-3;

                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text {
                                text: env.agent-name + ": " + env.task-description;
                                color: Colors.ink-body;
                                font-size: Typography.size-sm;
                                font-weight: Typography.weight-medium;
                            }
                            Text {
                                text: "Started: " + env.started-at;
                                color: Colors.ink-muted;
                                font-size: Typography.size-xs;
                            }
                        }

                        Text {
                            text: env.status;
                            color: Colors.status-info;
                            font-size: Typography.size-xs;
                            vertical-alignment: center;
                        }

                        Button {
                            text: "Cancel";
                            variant: ButtonVariant.ghost;
                            clicked => { root.cancel-execution-requested(env.id); }
                        }
                    }
                }
            }
        }

        // Log Output Stream Window
        Rectangle {
            vertical-stretch: 1;
            background: Colors.paper-sunken;
            border-radius: Borders.radius-md;
            border-width: Borders.width;
            border-color: Colors.border-subtle;

            VerticalLayout {
                padding: Spacing.space-3;
                spacing: Spacing.space-2;

                Text {
                    text: "Live Orchestrator Log Stream";
                    color: Colors.ink-muted;
                    font-size: Typography.size-2xs;
                    font-weight: Typography.weight-semibold;
                }

                ScrollArea {
                    vertical-stretch: 1;
                    Text {
                        text: root.active-log-output != "" ? root.active-log-output : "[System] Orchestrator idle. Active execution envelopes will stream log lines here.";
                        color: Colors.ink-body;
                        font-family: Typography.font-mono;
                        font-size: Typography.size-xs;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}
