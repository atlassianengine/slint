import { ScrollView } from "std-widgets.slint";
import { Borders, Colors, Motion, Spacing, Typography, Button, ButtonVariant } from "@UIKitSlint";

export struct MCPServerItem {
    id: string,
    name: string,
    transport: string,
    tool-count: int,
    status: string,
}

export component MCPManager inherits Rectangle {
    in property <[MCPServerItem]> servers;
    callback add-server-requested;
    callback ping-server-requested(string);

    background: Colors.paper-body;

    VerticalLayout {
        padding: Spacing.space-4;
        spacing: Spacing.space-3;

        HorizontalLayout {
            height: 36px;
            spacing: Spacing.space-3;
            Text {
                text: "MCP (Model Context Protocol) Servers";
                color: Colors.ink-headers;
                font-family: Typography.font-display;
                font-size: Typography.size-md;
                font-weight: Typography.weight-semibold;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: "+ Add Server";
                variant: ButtonVariant.default;
                clicked => { root.add-server-requested(); }
            }
        }

        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: Spacing.space-3;

                for server in root.servers: Rectangle {
                    height: 64px;
                    background: Colors.paper-surface;
                    border-radius: Borders.radius-md;
                    border-width: Borders.width;
                    border-color: Colors.border-subtle;

                    HorizontalLayout {
                        padding-left: Spacing.space-4;
                        padding-right: Spacing.space-4;
                        spacing: Spacing.space-4;

                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text {
                                text: server.name;
                                color: Colors.ink-body;
                                font-size: Typography.size-sm;
                                font-weight: Typography.weight-semibold;
                            }
                            Text {
                                text: "Transport: " + server.transport + " • Tools: " + server.tool-count;
                                color: Colors.ink-muted;
                                font-size: Typography.size-xs;
                            }
                        }

                        Text {
                            text: server.status;
                            color: Colors.status-success;
                            font-size: Typography.size-xs;
                            vertical-alignment: center;
                        }

                        Button {
                            text: "Ping";
                            variant: ButtonVariant.ghost;
                            clicked => { root.ping-server-requested(server.id); }
                        }
                    }
                }
            }
        }
    }
}
