import { RetrospectIcon, RetrospectIconName } from "../icons/retrospect_icon.slint";
import { Colors } from "@UIKitSlint";
import { WorkspacePalette } from "../../theme/workspace_palette.slint";
import { WorkspaceMotion } from "../../theme/workspace_motion.slint";
import { WorkspaceChrome } from "../../theme/workspace_chrome.slint";

export component HeaderRailItem inherits Rectangle {
    in property <RetrospectIconName> icon;
    in property <string> label;
    in property <bool> active: false;
    in property <length> expanded-width: 78px;
    callback clicked();

    height: WorkspaceChrome.rail-control-size;
    width: root.active ? root.expanded-width : WorkspaceChrome.rail-control-size;
    border-radius: WorkspaceChrome.rail-control-size / 2;
    background: input.has-hover && !root.active ? WorkspacePalette.hover-fill : transparent;
    clip: true;
    animate width { duration: WorkspaceMotion.active-item-duration; easing: cubic-bezier(0.2, 0, 0, 1); }
    animate background { duration: WorkspaceMotion.control-duration; easing: ease-out; }

    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: parent.border-radius;
        background: @radial-gradient(
            circle 24px at 12px 7px,
            WorkspacePalette.active-fill,
            WorkspacePalette.active-fill-muted 58%,
            WorkspacePalette.active-fill-quiet 100%
        );
        opacity: root.active ? 0.84 : 0;
        animate opacity { duration: WorkspaceMotion.control-duration; easing: ease-out; }
    }
    RetrospectIcon {
        x: (WorkspaceChrome.rail-control-size - WorkspaceChrome.rail-glyph-size) / 2;
        y: (WorkspaceChrome.rail-control-size - WorkspaceChrome.rail-glyph-size) / 2;
        width: WorkspaceChrome.rail-glyph-size;
        height: WorkspaceChrome.rail-glyph-size;
        icon: root.icon;
        icon-color: root.active ? Colors.ink-inverse : Colors.ink-muted;
        animate icon-color { duration: WorkspaceMotion.control-duration; easing: ease-out; }
    }
    Rectangle {
        x: WorkspaceChrome.rail-control-size;
        width: parent.width - WorkspaceChrome.rail-control-size;
        height: parent.height;
        clip: true;
        Text {
            x: 4px;
            width: parent.width - 4px;
            height: parent.height;
            text: root.label;
            color: Colors.ink-inverse;
            opacity: root.active ? 1 : 0;
            font-size: 10px;
            font-weight: 750;
            letter-spacing: 1.2px;
            vertical-alignment: center;
            animate opacity { duration: WorkspaceMotion.label-fade-duration; delay: WorkspaceMotion.label-fade-delay; easing: ease-out; }
        }
    }
    input := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component HeaderIconButton inherits Rectangle {
    in property <RetrospectIconName> icon;
    in property <string> label;
    in property <bool> active: false;
    callback clicked();

    width: WorkspaceChrome.rail-control-size;
    height: WorkspaceChrome.rail-control-size;
    border-radius: WorkspaceChrome.rail-control-size / 2;
    background: root.active ? @radial-gradient(
        circle 22px at 12px 7px,
        WorkspacePalette.active-fill,
        WorkspacePalette.active-fill-muted 62%,
        WorkspacePalette.active-fill-quiet 100%
    ) : input.has-hover ? WorkspacePalette.hover-fill : transparent;
    animate background { duration: WorkspaceMotion.control-duration; easing: ease-out; }

    RetrospectIcon {
        x: (parent.width - WorkspaceChrome.rail-glyph-size) / 2;
        y: (parent.height - WorkspaceChrome.rail-glyph-size) / 2;
        width: WorkspaceChrome.rail-glyph-size;
        height: WorkspaceChrome.rail-glyph-size;
        icon: root.icon;
        icon-color: root.active ? Colors.ink-inverse : Colors.ink-muted;
        animate icon-color { duration: WorkspaceMotion.control-duration; easing: ease-out; }
    }
    input := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}
